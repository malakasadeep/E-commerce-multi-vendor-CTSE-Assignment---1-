# Copy to .env and fill in real values. Never commit the real .env.

# --- Database ---
DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>

# --- Redis (Upstash) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# --- SMTP (transactional email) ---
SMTP_HOST=smtp.google.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# --- Stripe (sandbox / test mode) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe Connect onboarding redirects sellers
STRIPE_ONBOARDING_RETURN_URL=http://localhost:3001/stripe/onboarding

# --- Service ports ---
PRODUCT_SERVICE_PORT=6002
ORDER_SERVICE_PORT=6003
PAYMENT_SERVICE_PORT=6004
REVIEW_SERVICE_PORT=6005

# --- Kafka ---
KAFKA_CLIENT_ID=eshop
KAFKA_BROKERS=localhost:9092

# --- CORS ---
# Comma-separated origins allowed by all backend services.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Admin seed ---
ADMIN_SEED_EMAIL=admin@eshop.com
ADMIN_SEED_PASSWORD=
